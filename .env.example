# Этот файл используется для основной конфигурации приложения,
# если переименовать его в ".env" и оставить в корне установки BookStack.
# По умолчанию здесь указаны самые распространенные обязательные параметры.
# Полный список доступен в файле '.env.example.complete'.

# ВАЖНО: если значение содержит пробел или символ #, оберните его в кавычки
# (например, MAIL_FROM_NAME="BookStack Mailer").

# Ключ приложения.
# Используется для шифрования там, где это необходимо.
# Выполните `php artisan key:generate`, чтобы создать корректный ключ.
APP_KEY=replace_with_your_app_key

# URL приложения.
# Укажите корневой URL, по которому будет доступен BookStack.
# Все URL в BookStack будут формироваться на основе этого значения,
# чтобы ссылки оставались согласованными и безопасными.
# Если вы измените это значение позже, может понадобиться обновить
# сохраненные URL в базе данных. Пример команды:
# php artisan bookstack:update-url https://old.example.com https://new.example.com
APP_URL=https://example.com

# Язык интерфейса по умолчанию.
APP_LANG=ru

# Параметры базы данных.
DB_HOST=localhost
DB_DATABASE=database_database
DB_USERNAME=database_username
DB_PASSWORD=replace_with_your_db_password

# Система хранения.
# По умолчанию файлы хранятся в локальной файловой системе, а изображения
# размещаются в публичной веб-директории для быстрой отдачи веб-сервером.
# Другие варианты хранения и их особенности описаны здесь:
# https://www.bookstackapp.com/docs/admin/upload-config/
STORAGE_TYPE=local

# Почтовая система.
# Возможные значения: 'smtp' или 'sendmail'.
MAIL_DRIVER=smtp

# Данные отправителя писем.
MAIL_FROM_NAME="BookStack"
MAIL_FROM=bookstack@example.com

# Параметры SMTP.
# Эти настройки можно проверить через действие "Send a Test Email"
# в разделе "Settings > Maintenance".
# Подробная документация по почте:
# https://www.bookstackapp.com/docs/admin/email-webhooks/#email-configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
